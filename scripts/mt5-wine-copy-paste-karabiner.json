{
  "title": "MetaTrader 5 (Wine) Copy/Paste Fix",
  "rules": [
    {
      "description": "MT5 copy: Ctrl/Cmd+C -> Ctrl+Insert (Windows copy in Wine fields)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "insert", "modifiers": ["left_control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.metaquotes\\.wine"], "file_paths": [".*/MetaTrader 5\\.app/.*", ".*/FBS\\.app/.*", ".*/Market4You MT5\\.app/.*", ".*/WeMasterTrade MT5\\.app/.*", ".*/fbs\\.app/.*"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["command"], "optional": ["any"] }
          },
          "to": [{ "key_code": "insert", "modifiers": ["left_control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.metaquotes\\.wine"], "file_paths": [".*/MetaTrader 5\\.app/.*", ".*/FBS\\.app/.*", ".*/Market4You MT5\\.app/.*", ".*/WeMasterTrade MT5\\.app/.*", ".*/fbs\\.app/.*"] }]
        }
      ]
    },
    {
      "description": "MT5 paste: Ctrl/Cmd+V -> Shift+Insert (Windows paste in Wine fields)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "v",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "insert", "modifiers": ["left_shift"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.metaquotes\\.wine"], "file_paths": [".*/MetaTrader 5\\.app/.*", ".*/FBS\\.app/.*", ".*/Market4You MT5\\.app/.*", ".*/WeMasterTrade MT5\\.app/.*", ".*/fbs\\.app/.*"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "v",
            "modifiers": { "mandatory": ["command"], "optional": ["any"] }
          },
          "to": [{ "key_code": "insert", "modifiers": ["left_shift"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.metaquotes\\.wine"], "file_paths": [".*/MetaTrader 5\\.app/.*", ".*/FBS\\.app/.*", ".*/Market4You MT5\\.app/.*", ".*/WeMasterTrade MT5\\.app/.*", ".*/fbs\\.app/.*"] }]
        }
      ]
    },
    {
      "description": "MT5 select all: Ctrl/Cmd+A -> Ctrl+A in Wine",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": { "mandatory": ["command"], "optional": ["any"] }
          },
          "to": [{ "key_code": "a", "modifiers": ["left_control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^net\\.metaquotes\\.wine"], "file_paths": [".*/MetaTrader 5\\.app/.*", ".*/FBS\\.app/.*", ".*/Market4You MT5\\.app/.*", ".*/WeMasterTrade MT5\\.app/.*", ".*/fbs\\.app/.*"] }]
        }
      ]
    }
  ]
}
